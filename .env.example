NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.example
DATA_DIR=/data
# Railway volumes are root-owned. See README for the non-root entrypoint.
RAILWAY_RUN_UID=0
SESSION_SECRET=replace-with-at-least-32-random-characters
# The designated owner is also configured in server/config.js.
ADMIN_EMAILS=danilolisnicuk9@gmail.com
# Recommended on Railway: HTTPS email API (works on Hobby).
# Leave MAIL_PROVIDER empty to use Resend when RESEND_API_KEY exists, else SMTP.
MAIL_PROVIDER=
RESEND_API_KEY=
# MAIL_FROM must be a sender on your verified email domain.
MAIL_FROM=SNAP <shop@example.com>
MAIL_REPLY_TO=danilolisnicuk9@gmail.com
ORDER_EMAIL=danilolisnicuk9@gmail.com
# SMTP is optional and requires Railway Pro or higher.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Never enable DEV_AUTH in production. It is only for local manual testing.
DEV_AUTH=false
# Optional OpenAI-compatible structured outfit recommendation service.
# Three-dimensional visualization is rendered locally, not generated by this API.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=
